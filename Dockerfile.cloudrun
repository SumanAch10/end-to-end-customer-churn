FROM python:3.13-slim

WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

COPY src ./src
COPY artifacts/production_model /app/model

RUN mkdir -p /app/logs

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV MODEL_PATH=/app/model
ENV CHURN_THRESHOLD=0.30
ENV PORT=8080

EXPOSE 8080

CMD ["sh", "-c", "python3 -m uvicorn src.app.cloud_main:app --host 0.0.0.0 --port ${PORT}"]
